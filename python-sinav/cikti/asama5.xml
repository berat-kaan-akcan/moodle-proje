   <globalextra></globalextra>
   <useace>1</useace>
   <resultcolumns></resultcolumns>
   <template></template>
   <iscombinatortemplate></iscombinatortemplate>
   <allowmultiplestdins></allowmultiplestdins>
   <answer><![CDATA[def tekrarsiz(liste):
    gorulen = set()
    sonuc = []
    for x in liste:
        if x not in gorulen:
            gorulen.add(x)
            sonuc.append(x)
    return sonuc
]]></answer>

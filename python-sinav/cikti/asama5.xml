  <question type="coderunner">
   <name><text>s5_tekrarsiz - Tekrarları sil</text></name>
   <questiontext format="html"><text><![CDATA[<p><code>tekrarsiz(liste)</code> fonksiyonu, tekrar eden elemanları silip <b>ilk geçişlerin sırasını koruyarak</b> yeni bir liste döndürsün. Girdi listesini değiştirmeyin.</p>]]></text></questiontext>
   <generalfeedback format="html"><text></text></generalfeedback>
   <defaultgrade>10</defaultgrade>
   <penalty>0.1</penalty>
   <hidden>0</hidden>
   <coderunnertype>python3</coderunnertype>

   <iscombinatortemplate></iscombinatortemplate>
   <allowmultiplestdins></allowmultiplestdins>
   <answer><![CDATA[def faktoriyel(n):
    if n < 0:
        return -1
    s = 1
    for i in range(2, n + 1):
        s *= i
    return s
]]></answer>

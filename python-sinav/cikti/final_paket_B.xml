  <question type="coderunner">
   <name><text>s4_sezar - Sezar şifresi [Paket B]</text></name>
   <questiontext format="html"><text><![CDATA[<p><code>sifrele(metin, kaydir)</code> fonksiyonunu yazın. Yalnızca <code>a-z</code> ve <code>A-Z</code> harfleri alfabede <code>kaydir</code> kadar ileri kaydırılır (z&#x27;den sonra a&#x27;ya dönülür, büyük/küçük harf korunur). Diğer karakterler <b>aynen</b> kalır. <code>kaydir</code> negatif olabilir.</p>]]></text></questiontext>
   <generalfeedback format="html"><text></text></generalfeedback>
   <defaultgrade>15</defaultgrade>
   <penalty>0.1</penalty>
   <hidden>0</hidden>
   <coderunnertype>python3</coderunnertype>
   <prototypetype>0</prototypetype>
   <allornothing>0</allornothing>
   <penaltyregime>10, 20, ...</penaltyregime>
   <precheck>0</precheck>
   <hidecheck>0</hidecheck>
   <showsource>0</showsource>
   <answerboxlines>18</answerboxlines>
   <answerboxcolumns>100</answerboxcolumns>
   <answerpreload></answerpreload>
   <globalextra></globalextra>
   <useace>1</useace>
   <resultcolumns></resultcolumns>
   <template></template>
   <iscombinatortemplate></iscombinatortemplate>
   <allowmultiplestdins></allowmultiplestdins>
   <answer><![CDATA[def sifrele(metin, kaydir):
    sonuc = ''
    for c in metin:
        if 'a' <= c <= 'z':
            sonuc += chr((ord(c) - 97 + kaydir) % 26 + 97)
        elif 'A' <= c <= 'Z':
            sonuc += chr((ord(c) - 65 + kaydir) % 26 + 65)
        else:
            sonuc += c
    return sonuc
]]></answer>

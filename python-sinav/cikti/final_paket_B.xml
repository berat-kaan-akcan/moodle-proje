   <iscombinatortemplate></iscombinatortemplate>
   <allowmultiplestdins></allowmultiplestdins>
   <answer><![CDATA[def ucgen_turu(a, b, c):
    if min(a, b, c) <= 0 or max(a, b, c) >= a + b + c - max(a, b, c):
        return 'Gecersiz'
    if a == b == c:
        return 'Eskenar'
    if a == b or b == c or a == c:
        return 'Ikizkenar'
    return 'Caliskenar'
]]></answer>

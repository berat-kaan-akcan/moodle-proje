   <answer><![CDATA[import sys
satir = kelime = karakter = 0
for s in sys.stdin:
    s = s.rstrip('\n')
    if s.strip() == '':
        continue
    satir += 1
    kelime += len(s.split())
    karakter += len(s.replace(' ', ''))

   <allowmultiplestdins></allowmultiplestdins>
   <answer><![CDATA[def ikili_ara(liste, x):
    sol, sag = 0, len(liste) - 1
    while sol <= sag:
        orta = (sol + sag) // 2
        if liste[orta] == x:
            return orta
        if liste[orta] < x:
            sol = orta + 1
        else:
            sag = orta - 1
    return -1
]]></answer>

   <answer><![CDATA[while True:
    satir = input()
    if satir == 'son':
        break
    try:
        a, b = satir.split()
        print(f'{float(a) / float(b):.2f}')
    except ZeroDivisionError:
        print('Sifira bolunemez')
    except ValueError:
        print('Gecersiz giris')
]]></answer>

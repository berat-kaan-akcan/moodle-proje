   <answer><![CDATA[def dengeli_mi(s):
    cift = {')': '(', ']': '[', '}': '{'}
    y = []
    for c in s:
        if c in '([{':
            y.append(c)
        elif c in cift:
            if not y or y.pop() != cift[c]:
                return False
    return not y
]]></answer>
